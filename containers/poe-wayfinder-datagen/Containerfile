# Container image for poe-wayfinder-datagen.
#
# Multi stage. The runtime image carries no build tooling and runs as a non
# root user. Both cut the attack surface an operator has to reason about.

FROM docker.io/library/rust:1.97-slim AS build
WORKDIR /src
COPY . .
RUN cargo build --release --bin poe-wayfinder-datagen \
    && mkdir -p /out && cp target/release/poe-wayfinder-datagen /out/poe-wayfinder-datagen

FROM gcr.io/distroless/cc-debian12:nonroot
WORKDIR /app
COPY --from=build /out /app

USER 65532:65532

ENTRYPOINT ["/app/poe-wayfinder-datagen"]
